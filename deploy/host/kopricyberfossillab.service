# kopricyberfossillab 화면 서버 — 서버가 재부팅돼도 저절로 뜨게. 깔기는 deploy/host/install-service.sh (sudo 로 한 번).
#
# sclee 로 돈다 — ~/.claude(세션 등록·job·JSONL)는 그 계정만 읽을 수 있다.
# 표지(~/.claude/fl-visible)를 켠 다른 계정의 집도 읽게 CAP_DAC_READ_SEARCH(읽기·디렉터리 훑기만, 쓰기·root 아님)를 준다 (koprifossillab P01).
# 이 힘은 모든 파일에 닿는다 — 무엇을 여는지는 server/paths.ts·office.ts 가 지킨다. 그 밖의 힘은 경계 집합에서 뺀다.
# 서버가 부르는 tmux·ps·git 은 PATH 에서 찾는다(/usr/bin). tmux 는 uid 로 소켓을 고른다 —
# sclee(uid 1006)로 돌면 /tmp/tmux-1006/default 를 그대로 본다. 그래서 PrivateTmp 를 켜지 않는다(켜면 /tmp 가 갈려 터미널이 안 보인다).
# web/dist 가 없으면 화면 대신 503 이 나간다 — 판을 바꾸면 그 클론에서 npm run build 뒤 systemctl restart kopricyberfossillab.
[Unit]
Description=kopricyberfossillab — Claude Code 세션 화면 (127.0.0.1:8098)
After=network.target

[Service]
Type=simple
User=sclee
Group=sclee
WorkingDirectory=/home/sclee/projects/kopricyberfossillab
Environment=HOME=/home/sclee
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=FL_PORT=8098 FL_HOST=127.0.0.1
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ExecStart=/home/sclee/projects/kopricyberfossillab/node_modules/.bin/tsx server/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
